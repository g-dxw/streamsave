{
  "name": "streamsave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StreamSave 流存：本地视频批量下载工作台，支持 HLS 预览、并发控制和编号命名",
  "repository": { "type": "git", "url": "https://github.com/g-dxw/streamsave.git" },
  "homepage": "https://github.com/g-dxw/streamsave#readme",
  "bugs": { "url": "https://github.com/g-dxw/streamsave/issues" },
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check public/app.js && node --check server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@svta/cml-cmcd": "2.4.0",
    "@svta/cml-id3": "1.0.6",
    "@svta/cml-utils": "1.5.0",
    "eventemitter3": "5.0.4",
    "url-toolkit": "2.2.5"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.2.8",
    "@phosphor-icons/core": "^2.1.1",
    "esbuild": "^0.25.12"
  }
}
